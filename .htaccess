DirectoryIndex index.php

# Canvas .msapp packages are often larger than PHP's default 2M upload limit.
# Works with mod_php; for php-fpm/cgi also see .user.ini next to this file.
<IfModule mod_php.c>
  php_value upload_max_filesize 512M
  php_value post_max_size 512M
  php_value max_execution_time 600
  php_value max_input_time 600
  php_value memory_limit 1024M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 512M
  php_value post_max_size 512M
  php_value max_execution_time 600
  php_value max_input_time 600
  php_value memory_limit 1024M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 512M
  php_value post_max_size 512M
  php_value max_execution_time 600
  php_value max_input_time 600
  php_value memory_limit 1024M
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /power_sweeper/

  # Assets symlink covers most cases; keep rewrite as fallback
  RewriteRule ^assets/(.*)$ public/assets/$1 [L]

  # Front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>
